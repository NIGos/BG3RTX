{
  "name": "p1-fg-motion-matrix",
  "tree": ".",
  "save": "QuickSave_3784",
  "session": false,
  "traces": 0,
  "hold": 90,
  "timeout": 3660,
  "set": "preset=ultra,fg=2,headless=0,fps_cap=0,rr=1,reflex=1,rt_stats=0,ls_stats=0,rf_stats=0,ls_k=0,ls_shadowed=1,rt_debug=0,ls_debug=0,gi_debug=0,rf_debug=0,rr_show=0,pan_capture=0,pan_prepare=0,rt_scene_camera_match=0,rt_scene_rebase=0,fg_current_destroy_only=0,rt_primary_check=1,rt_primary_epoch=1,crash_dump=1,fg_state_every=30,rt_timing_frames=120,dump_images=1,dump_png_width=1280,dump_raw=0,dump_max_mb=6144",
  "window_mode": "visible_unfocused_fg",
  "args": [
    "-RealPresent",
    "-Move",
    "-MovePlan",
    "tests/fixtures/p1_fg_motion_plan.json"
  ],
  "patterns": [
    "primary-ray check",
    "rt epoch",
    "rt passes",
    "rt cost scope",
    "\\[watch\\]",
    "\\[sl\\]",
    "\\[trace\\]",
    "gpu RR:",
    "hybrid GI",
    "ls stats",
    "rf stats",
    "material classes",
    "rt applied",
    "\\[crash\\]"
  ],
  "expect": [
    "\\[auto\\] scene ready",
    "\\[crash\\] exception diagnostics active independently of FG; minidump armed",
    "DLSS-G supported on this adapter: ok",
    "slDLSSGSetOptions\\(mode on",
    "slDLSSGSetOptions\\(mode off",
    "rt epoch",
    "primary-ray check"
  ],
  "forbid": [
    "\\[crash\\] exception 0x",
    "VK_ERROR_DEVICE_LOST"
  ],
  "expect_runner": [
    "\\[motion-plan\\] posted pointer centre",
    "\\[window-mode\\] visible_unfocused:",
    "\\[motion-plan\\] complete phases=",
    "^Run ended: done",
    "\\[rotation-input\\].*direction=1",
    "\\[rotation-input\\].*direction=-1"
  ],
  "post_gate": true,
  "post": "py -3 -m scripts.qa.fg_motion_gate --log \"{log}\" --runner \"{runner}\" --plan tests/fixtures/p1_fg_motion_plan.json --out captures/p1-fg/motion-gate-result.json",
  "requires_success_of": [
    "p1-fg-static-effects"
  ]
}
