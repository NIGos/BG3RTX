      "match": "rays [0-9.]+/frame:.*hidden [0-9.]+%.*off screen [0-9.]+%.*miss [0-9.]+%",
      "windows": [
        "cost-off-a",
        "cost-on",
        "cost-off-b"
      ],
      "min": 1
    },
    {
      "name": "float samples every shot and turn",
      "select": "\\[trace\\] frame \\d+ written: ",
      "match": "\\[trace\\] frame \\d+ written: ",
      "windows": [
        "shot-off-a",
        "shot-on",
        "shot-off-b",
        "turn-off-a",
        "turn-on",
        "turn-off-b"
      ],
      "event": true,
      "min": 2,
      "settle_s": 1
    },
    {
      "name": "qualified hidden shading in every ON cost window",
      "select": "\\[water\\] compose \\(",
      "match": "hit shade attempted [1-9]\\d*, hidden [1-9]\\d*, offscreen \\d+, rejected material/light/sun/invalid \\d+/\\d+/\\d+/\\d+",
      "windows": [
        "cost-on"
      ],
      "min": 1
    },
    {
      "name": "reflections GPU cost in every static window",
      "select": "\\[water\\] reflections GPU",
      "match": "GPU.*[0-9.]+",
      "windows": [
        "cost-off-a",
        "cost-on",
        "cost-off-b"
      ],
      "min": 1
    },
    {
      "name": "compose GPU cost in every static window",
      "select": "\\[water\\] compose GPU",
      "match": "GPU.*[0-9.]+",
      "windows": [
        "cost-off-a",
        "cost-on",
        "cost-off-b"
      ],
      "min": 1
    },
    {
      "name": "no mesh pool exhaustion in measured windows (load excluded)",
      "select": "\\[(?:rt|bvh)\\] mesh.*pool full",
      "match": "(?!)",
      "event": true,
      "min": 0,
      "windows": [
        "cost-off-a",
        "shot-off-a",
        "cost-on",
        "shot-on",
        "cost-off-b",
        "shot-off-b",
        "turn-off-a",
        "turn-on",
        "turn-off-b"
      ]
    },
    {
      "name": "water geometry coverage",
      "select": "\\[water\\] coverage \\(",
      "match": "captured [1-9]\\d* of [1-9]\\d* water draws \\(100\\.0%\\).*triangles [1-9]\\d* of [1-9]\\d* supported \\(100\\.0%\\).*non-finite 0, collapsed 0",
      "period_frames": 120,
      "min": 1,
      "windows": [
        "cost-off-a",
        "cost-on",
        "cost-off-b"
      ]
    },
    {
      "name": "no roof overflow",
      "select": "sun: WARNING \\d+ roof volumes within|over kSunMaxVolumes on [1-9]",
      "match": "(?!)",
      "event": true,
      "min": 0,
      "windows": [
        "cost-off-a",
        "cost-on",
        "cost-off-b"
      ]
    },
    {
      "name": "world query never truncates",
