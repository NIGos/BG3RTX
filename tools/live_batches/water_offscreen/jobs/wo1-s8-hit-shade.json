  "stop_on_dump": false,
  "purpose": "S8 Ultra hit shading 0/1/0/1 static and matched wf9 turns, compose shift fixed on; draft only.",
  "estimated_phase_seconds": 249,
  "expect_every": [
    {
      "name": "scene wait: every cost window traces its own frame's scene (0 timeouts; stale shadows otherwise)",
      "select": "\\[rt\\] scene wait: \\d+ frames",
      "match": "got this frame's scene, 0 timeouts",
      "min": 1,
      "windows": [
        "shot-off-a",
        "shot-on-a",
        "shot-off-b",
        "shot-on-b",
        "cost-turn-0",
        "cost-turn-1",
        "cost-turn-2",
        "cost-turn-3"
      ]
    },
    {
      "name": "capacity: the RT capture drops no opaque draw (buffer full 0.00) in every traced cost window",
      "select": "\\[geo\\] RT capture, last \\d+ frames:",
      "match": "opaque draws dropped \\(buffer full\\) 0\\.00,",
      "min": 1,
      "windows": [
        "shot-off-a",
        "shot-on-a",
        "shot-off-b",
        "shot-on-b",
        "cost-turn-0",
        "cost-turn-1",
        "cost-turn-2",
        "cost-turn-3"
      ]
    },
    {
      "name": "capacity: the cascade casters buffer is never full (buffer full 0.0) in every traced cost window with the casters on",
      "select": "\\[cascade\\] casters: cascade \\d+, \\d+ frames;",
      "match": ", buffer full 0\\.0, added ",
      "min": 1,
      "when_present": true,
      "windows": [
        "shot-off-a",
        "shot-on-a",
        "shot-off-b",
        "shot-on-b",
        "cost-turn-0",
        "cost-turn-1",
        "cost-turn-2",
        "cost-turn-3"
      ]
    },
    {
      "name": "continuity",
      "select": "\\[core\\] \\[water\\] compose stability",
      "match": "uncomposed 0 \\(on/off flips 0\\)",
      "min": 1,
      "windows": [
        "shot-off-a",
        "shot-on-a",
        "shot-off-b",
        "shot-on-b",
        "cost-turn-0",
        "cost-turn-1",
        "cost-turn-2",
        "cost-turn-3"
      ]
    },
    {
      "name": "reflection stats",
      "select": "\\[core\\] \\[water\\] reflections \\(",
      "match": "\\[water\\] reflections \\(\\d+ frames, [1-9]\\d* traced\\)",
      "min": 1,
      "windows": [
        "shot-off-a",
        "shot-on-a",
        "shot-off-b",
        "shot-on-b",
        "cost-turn-0",
        "cost-turn-1",
        "cost-turn-2",
        "cost-turn-3"
      ]
    },
    {
      "name": "compose tiers",
      "select": "\\[core\\] \\[water\\] compose \\(",
      "match": "screen hit \\(composed\\) [0-9.]+%, hidden [0-9.]+%.*aborted 0, invalid 0",
      "min": 1,
      "windows": [
        "shot-off-a",
        "shot-on-a",
        "shot-off-b",
        "shot-on-b",
        "cost-turn-0",
        "cost-turn-1",
        "cost-turn-2",
        "cost-turn-3"
      ]
    },
    {
      "name": "compose GPU ms",
      "select": "\\[core\\] \\[water\\] compose GPU",
      "match": "compose GPU [0-9.]+ ms median.*compose dispatches [0-9.]+ ms median",
      "min": 1,
      "windows": [
        "shot-off-a",
        "shot-on-a",
        "shot-off-b",
        "shot-on-b",
        "cost-turn-0",
        "cost-turn-1",
        "cost-turn-2",
        "cost-turn-3"
      ]
    },
    {
      "name": "compose hidden and offscreen hit shading in every ON window",
      "select": "\\[water\\] compose \\(",
      "match": "hit shade attempted [1-9]\\d*, hidden [1-9]\\d*, offscreen [1-9]\\d*, rejected material/light/sun/invalid \\d+/\\d+/\\d+/0",
      "min": 1,
      "windows": [
        "shot-on-a",
        "shot-on-b",
        "cost-turn-1",
        "cost-turn-3"
      ]
    },
    {
      "name": "reflections hidden and offscreen hit shading in every ON window",
      "select": "\\[water\\] reflections \\(",
      "match": "hit shade attempted [1-9]\\d*, hidden [1-9]\\d*, offscreen [1-9]\\d*, rejected material/light/sun/invalid \\d+/\\d+/\\d+/0",
      "min": 1,
      "windows": [
        "shot-on-a",
        "shot-on-b",
        "cost-turn-1",
        "cost-turn-3"
      ]
    },
    {
      "name": "static float energy inputs",
      "select": "\\[trace\\] frame \\d+ written:",
      "match": "\\[trace\\] frame \\d+ written:",
