    "\\[motion-trace\\] phase=3 label=shot-off-b repeat=2",
    "\\[motion-trace\\] phase=4 label=shot-on-b repeat=0",
    "\\[motion-trace\\] phase=4 label=shot-on-b repeat=1",
    "\\[motion-trace\\] phase=4 label=shot-on-b repeat=2",
