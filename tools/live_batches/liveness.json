    {"id": "hit_material_passes", "feature": "hit materials run on the committed scene", "when": {"rt_hit_material": "1", "rt_scene_handout": ">0", "rt_scene_handout_hit_wait": "1"},
     "presets": ["ultra"], "kind": "positive", "covers": ["rt_hit_material_instanced"],
     "line": "\\[core\\] scene handout: .*hit material passes on the committed scene (?P<v>\\d+)"},
    {"id": "cascade_casters", "feature": "cascade casters added to the sun BVH", "when": {"rt_cascade_casters": "1"},
     "presets": ["ultra"], "kind": "positive",
     "line": "\\[cascade\\] casters: .*added (?P<v>[\\d.]+)"},
    {"id": "alpha_tested", "feature": "alpha-tested draws in RT", "when": {"rt_alpha": "1"},
     "presets": ["high", "ultra"], "kind": "positive",
     "line": "\\[alpha\\] last \\d+ frames: (?P<v>[\\d.]+) alpha-tested draws"},
    {"id": "native_hair", "feature": "native hair coverage records (heads in view)", "when": {"rt_native_hair": "1"},
     "presets": ["ultra"], "kind": "positive", "only_if": "\\[geo\\] RT capture stride split, .*-byte strand-frame draws (?P<v>[\\d.]+) per frame",
     "line": "\\[alpha hair\\] native coverage records (?P<v>\\d+)"},
    {"id": "water_compose", "feature": "water compose", "when": {"rt_water_compose": "1"},
     "presets": ["ultra"], "kind": "positive", "covers": ["rt_water_geometry", "rt_water_compose_shift"],
