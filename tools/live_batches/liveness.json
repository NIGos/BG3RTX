{
  "_doc": [
    "Liveness spec (docs/REGRESSION_PROCESS.md): for each feature that is on in a preset, the log line that proves it does work.",
    "Checker: tools/live_batches/liveness.py. Every queue run is judged with it (scripts/test-queue.ps1); the release smoke gates on it.",
    "Row fields: id; feature; when = settings the row needs, judged per [cfg] settings read segment ('1', '>0', '!0');",
    "presets = where the row is on by default (a test checks that 'when' holds there); kind:",
    "  positive: 'line' has a group (?P<v>...); ALIVE when one line in the preset has v > 0 (or v >= 'min'), DEAD when",
    "            at least 'min_lines' (default 3) lines all fail. 'only_if' (regex with v) is a scene precondition:",
    "            without an only_if line with v > 0 the row is UNPROVEN (the scene has no water, no effects pass).",
    "            A positive row's min_s (default 0) is the time on before it can be DEAD (FG presents 1 in menus).",
    "  appear:   'line' must appear; DEAD when it does not in at least 'min_s' (default 120) seconds with the row on.",
    "  absent:   'line' must NOT appear; ALIVE needs the 'proof' line (the path ran), else UNPROVEN.",
    "once: true = a launch-time line (masks, core, asset DB): judged over the whole log, not per preset.",
    "silent_dead: true = with detailed logging, a positive row whose stats line never printed in min_s (default 120) is DEAD.",
    "'covers' lists further keys the row proves. 'caught' names the regression the row exists for. 'follows' names the rows of its cause: a DEAD row whose cause row is DEAD in the same preset says so.",
    "Rule (AGENTS.md): a key whose default or preset value becomes non-zero needs a row in the same branch (or an",
    "'exempt' reason). baseline_no_row holds the keys that were non-zero on 2026-11-23 without a row: shrink it, never grow it."
  ],
  "rows": [
    {"id": "omm_handout_commits", "feature": "OMM traversal on the handed-out scene", "when": {"rt_omm": "1", "rt_scene_handout": ">0"},
     "presets": ["high", "ultra"], "kind": "positive",
     "line": "\\[rt\\] scene handout: .*OMM accelerated commits (?P<v>\\d+)",
     "caught": "2026-11-14..21: 'OMM accelerated commits 0' in every handout line for a week (retained latch)"},
    {"id": "omm_session_latch", "feature": "OMM not switched off for the session", "when": {"rt_omm": "1"},
     "presets": ["high", "ultra"], "kind": "absent",
     "line": "\\[omm\\] (rejected ticket use|resource provenance/completion unavailable|producer disabled after EXT record failure|off for this session)",
     "proof": "\\[(omm dyn|rt\\] scene handout)",
     "caught": "the same week: '[omm] rejected ticket use ... retaining until idle' once per session"},
    {"id": "omm_dyn_scenes", "feature": "OMM per-draw micro-maps reach the scene", "when": {"rt_omm_dyn": "1"},
     "presets": ["high", "ultra"], "kind": "positive", "covers": ["rt_alpha_fine_lod"], "silent_dead": true, "min_s": 60,
     "line": "\\[omm dyn\\] last \\d+ builds .*accelerated scenes (?P<v>\\d+)"},
    {"id": "vt_masks_loaded", "once": true, "feature": "VT alpha masks loaded", "when": {"rt_vt_alpha_masks": "1"},
     "presets": ["high", "ultra"], "kind": "positive", "min_lines": 1,
     "line": "\\[vt alpha\\] (?P<v>\\d+) masks loaded"},
    {"id": "vt_masks_valid", "once": true, "feature": "no VT alpha mask rejected", "when": {"rt_vt_alpha_masks": "1"},
     "presets": ["high", "ultra"], "kind": "absent",
     "line": "\\[vt alpha\\] \\S+ invalid: skipped", "proof": "\\[vt alpha\\] \\d+ masks loaded",
     "caught": "2026-11-02..23: 17 of 71 masks rejected at every launch"},
    {"id": "level_known", "feature": "asset DB knows the level (sun replace, roofs, per-light data)", "when": {"rt_shadows": "1", "rt_sun_replace": "1"},
     "presets": ["medium", "high", "ultra"], "kind": "absent", "covers": ["rt_sun_roofs"],
     "line": "level unknown: nothing trusted", "proof": "\\[core\\] sun stats \\(",
     "caught": "2026-11-07..23: 'level unknown: nothing trusted' in every log after Patch 8 (zstd saves)"},
    {"id": "sun_replace_active", "feature": "traced sun replaces the game's dark pixels", "when": {"rt_shadows": "1", "rt_sun_replace": "1"},
     "presets": ["medium", "high", "ultra"], "kind": "positive",
     "line": "\\[core\\] sun stats \\(\\d+ frames, replace (?P<v>\\d)"},
    {"id": "roof_volumes", "feature": "roof volumes for sun replace and far GI", "when": {"rt_shadows": "1", "rt_sun_roofs": "1"},
     "presets": ["medium", "high", "ultra"], "kind": "positive", "covers": ["gi_far", "gi_far_m"],
     "line": "\\[core\\] sun stats \\(\\d+ frames, replace \\d, (?P<v>\\d+) roof volumes"},
    {"id": "ls_per_light_data", "feature": "D-LS per-light radii from the asset DB", "when": {"rt_local_shadows": "1", "ls_lights": "1"},
     "presets": ["medium", "high", "ultra"], "kind": "appear",
     "line": "ls: per-light data: [1-9]\\d* runtime lights"},
    {"id": "sun_traced", "feature": "RT sun shadows trace pixels", "when": {"rt_shadows": "1"},
     "presets": ["medium", "high", "ultra"], "kind": "positive",
     "line": "\\[core\\] sun stats .*\\): traced (?P<v>[\\d.]+)% of px"},
    {"id": "sun_resolve", "feature": "sun resolve pass (rt_sun_replace trust: roofs, off-screen ramp)",
     "when": {"rt_shadows": "1", "rt_sun_replace": "1"}, "presets": ["medium", "high", "ultra"], "kind": "positive",
     "silent_dead": true, "follows": ["level_known", "roof_volumes"],
     "covers": ["rt_sun_offscreen", "rt_sun_ramp", "rt_sun_rise", "rt_sun_roof_pad", "rt_sun_roof_up"],
     "line": "\\[core\\] gi: sun resolve pass GPU cost (?P<v>[\\d.]+) ms",
     "caught": "2026-11-07..23 (hunt2_claims D3): the pass never ran while the level was unknown, 0 of 32 logs had its line"},
    {"id": "tlas_built", "feature": "RT passes get a TLAS", "when": {"rt_shadows": "1"},
     "presets": ["medium", "high", "ultra"], "kind": "positive",
     "line": "\\[core\\] rt passes: GPU cost [\\d.]+ ms/frame \\(average of \\d+ frames\\); TLAS this frame (?P<v>\\d+)"},
    {"id": "gi_trace", "feature": "ray-traced GI trace pass", "when": {"gi": "1", "gi_rt": "1"},
     "presets": ["medium", "high", "ultra"], "kind": "positive", "covers": ["gi_rays", "gi_rr_rays", "gi_steps"],
     "line": "\\[core\\] gi: trace pass .*GPU median (?P<v>[\\d.]+) ms"},
    {"id": "gi_sun_trace", "feature": "GI sun trace pass", "when": {"gi": "1", "gi_rt": "1", "gi_hit_sun": "1"},
     "presets": ["ultra"], "kind": "positive",
     "line": "\\[core\\] gi: sun trace pass GPU cost (?P<v>[\\d.]+) ms"},
    {"id": "rf_pass", "feature": "RT reflections pass", "when": {"rt_reflections": "1"},
     "presets": ["medium", "high", "ultra"], "kind": "positive", "covers": ["rf_max_rough"],
     "line": "\\[core\\] rf: reflection pass GPU median (?P<v>[\\d.]+) ms"},
    {"id": "ls_pass", "feature": "local-light shadow pass", "when": {"rt_local_shadows": "1"},
     "presets": ["medium", "high", "ultra"], "kind": "positive", "covers": ["ls_shadowed"],
