    {"id": "emissive_lights", "feature": "emissive capture finds lights", "when": {"rt_emissive": "1"},
     "presets": ["ultra"], "kind": "positive",
     "only_if": "\\[em\\] last \\d+ builds, per build: (?P<v>[\\d.]+) effects passes",
