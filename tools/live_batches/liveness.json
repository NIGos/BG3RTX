    {"id": "water_reflections", "feature": "water reflections traced", "when": {"rt_water_reflections": "1"},
     "presets": ["ultra"], "kind": "positive",
     "only_if": "\\[water\\] coverage \\(\\d+ frames\\): water passes (?P<v>[\\d.]+)/frame",
     "line": "\\[core\\] \\[water\\] reflections \\(\\d+ frames, (?P<v>\\d+) traced"},
    {"id": "water_shadows", "feature": "water sun shadows", "when": {"rt_water_shadows": "1"},
     "presets": ["ultra"], "kind": "positive",
     "only_if": "\\[water\\] coverage \\(\\d+ frames\\): water passes (?P<v>[\\d.]+)/frame",
     "line": "\\[core\\] \\[water\\] shadows \\(\\d+ frames, (?P<v>\\d+) passes"},
    {"id": "water_refraction", "feature": "water refraction", "when": {"rt_water_refraction": "1"},
     "presets": ["ultra"], "kind": "positive",
     "only_if": "\\[water\\] coverage \\(\\d+ frames\\): water passes (?P<v>[\\d.]+)/frame",
