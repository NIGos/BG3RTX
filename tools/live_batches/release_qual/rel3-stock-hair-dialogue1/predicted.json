{
  "status": "READY_FOR_LIVE",
  "save": "Test Dialogue1",
  "max_minutes": 5,
  "hard_timeout_seconds": 300,
  "load_allowance_seconds": 120,
  "expected_minutes": 3.32,
  "scheduled_seconds": 79.1,
  "readiness_seconds": 0.015,
  "captures": 1,
  "disk_estimate_mb": 70,
  "expect": [
    "\\[auto\\] scene ready",
    "\\[hot\\] core generation \\d+ loaded",
    "\\[ngx\\] RR create .*: Success",
    "\\[geo\\] transform feedback enabled: .*\\(stride 88\\)"
  ],
  "expect_every": [
    {
      "name": "capacity: the RT capture drops no opaque draw (buffer full 0.00) in every smoke window",
      "select": "\\[geo\\] RT capture, last \\d+ frames:",
      "match": "opaque draws dropped \\(buffer full\\) 0\\.00,",
      "min": 1,
      "windows": [
        "static-a",
        "static-b",
        "cost-hair"
      ]
    },
    {
      "name": "capacity: the cascade casters buffer is never full (buffer full 0.0) in every smoke window with the casters on",
      "select": "\\[cascade\\] casters: cascade \\d+, \\d+ frames;",
      "match": ", buffer full 0\\.0, added ",
      "min": 1,
      "windows": [
        "static-a",
        "static-b",
        "cost-hair"
      ],
      "when_present": true
    },
    {
      "name": "scene wait: 0 timeouts in every smoke window (static, pan, rotation)",
      "select": "\\[rt\\] scene wait: \\d+ frames",
      "match": "got this frame's scene, 0 timeouts",
      "min": 1,
      "windows": [
        "static-a",
        "static-b",
        "cost-hair"
      ]
    },
    {
      "name": "VRAM: process usage stays within the driver's real budget in every smoke window",
      "select": "\\[mem\\] ours \\(",
      "match": "\\(within budget\\); guard (normal|LOW)",
      "event": true,
      "settle_s": 1,
      "min": 1,
      "windows": [
        "static-a",
        "static-b",
        "cost-hair"
      ]
    },
    {
      "name": "native hair coverage active; valid bounds",
      "select": "\\[alpha hair\\] native coverage records \\d+;",
      "match": "native coverage records [1-9]\\d*; invalid/missing native state 0;.*retired bounds-invalid primitives 0;",
      "windows": [
        "static-a",
        "static-b",
        "cost-hair"
      ],
      "min": 1
    },
    {
      "name": "native scalp participation",
      "select": "\\[alpha scalp\\] native hard records \\d+;",
      "match": "native hard records (?:[1-9]\\d*; native camera dither records \\d+|\\d+; native camera dither records [1-9]\\d*); invalid/missing native state 0;",
      "windows": [
        "static-a",
        "static-b",
        "cost-hair"
      ],
      "min": 1
    },
    {
      "name": "first-enable compilation complete, no skipped pass",
      "select": "gi: background builds \\(\\d+ frames\\):",
      "match": ": 0 frames waiting, 0 pending, 0 started",
      "windows": [
        "static-a",
        "static-b",
        "cost-hair"
      ],
      "min": 1
    },
    {
      "name": "GPU cost with stock hair",
      "select": "rt passes: GPU cost",
      "match": "TLAS this frame [1-9]\\d*, previous frame 0, none 0",
      "windows": [
        "cost-hair"
      ],
      "min": 1
    },
    {
      "name": "GI cost with stock hair",
      "select": "gi: GPU cost",
      "match": "gi: GPU cost [0-9.]+ ms/frame",
      "windows": [
        "cost-hair"
      ],
      "min": 1
    },
    {
      "name": "stock cards: no strand producer",
      "select": "\\[hair (?:primary|groom)\\] (?:frame|coverage|strand|counted)",
      "match": "(?!)",
      "min": 0,
      "event": true
    },
    {
      "name": "float pre-post energy exported",
      "select": "\\[trace\\] frame \\d+ written:",
      "match": "\\[trace\\] frame \\d+ written:",
      "windows": [
        "energy-static"
      ],
      "min": 1,
      "event": true
    },
    {
      "name": "release cost: rt passes: GPU cost",
      "select": "rt passes: GPU cost",
      "match": "TLAS this frame [1-9]\\d*, previous frame 0, none 0",
      "windows": [
        "static-a",
        "cost-hair"
      ],
      "min": 1
    },
    {
      "name": "release cost: gi: GPU cost",
      "select": "gi: GPU cost",
      "match": "gi: GPU cost [0-9.]+ ms/frame",
      "windows": [
        "static-a",
        "cost-hair"
      ],
      "min": 1
    },
    {
      "name": "release cost: \\[rrpost\\] gpu:",
      "select": "\\[rrpost\\] gpu:",
      "match": "render-res chain [\\d.]+ ms/frame, output-res grade [\\d.]+ ms/frame",
      "windows": [
        "static-a",
        "cost-hair"
      ],
      "min": 1
    },
    {
      "name": "release cost: \\[ngx\\] gpu RR:",
      "select": "\\[ngx\\] gpu RR:",
      "match": "gpu RR: guides [\\d.]+ ms \\+ evaluate [\\d.]+ ms",
      "windows": [
        "static-a",
        "cost-hair"
      ],
      "min": 1
    }
  ],
  "forbid": [
    "\\[crash\\] exception 0x",
    "VK_ERROR_DEVICE_LOST",
    "\\[hot\\] core (rejected|faulted)",
    "FAILED, keeping previous",
    "compile call failed",
    "RR creation failed",
    "RR evaluate failed"
  ]
}
