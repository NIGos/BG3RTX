    {
      "name": "no background build in any measured window (0 waiting, 0 pending, 0 started in every status line)",
      "select": "gi: background builds \\(\\d+ frames\\):",
      "match": ": 0 frames waiting, 0 pending, 0 started",
      "min": 1,
      "windows": [
        "cost-cards-a",
        "cost-strands",
        "cost-cards-b",
        "cost-after-reload"
      ]
    },
    {
      "name": "no 'building in the background' line in any measured window (a pass skipped there)",
      "select": "building in the background",
      "match": "(?!)",
      "min": 0,
      "event": true,
      "windows": [
        "cost-cards-a",
        "cost-strands",
        "cost-cards-b",
        "cost-after-reload"
      ]
    },
    {
      "name": "hair guards zero in every judged window",
      "select": "\\[alpha hair\\] native coverage records",
      "match": "invalid/missing native state 0;.*retired bounds-invalid primitives 0;",
      "min": 1,
      "windows": [
        "cost-cards-a",
        "cost-strands",
        "cost-cards-b",
        "cost-after-reload"
      ]
    },
