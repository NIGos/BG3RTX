      "min": 1,
      "windows": [
        "cost-cards-a",
        "cost-strands",
        "cost-cards-b",
        "cost-after-reload"
      ]
    },
    {
      "name": "capacity: the cascade casters buffer is never full in every judged window",
      "select": "\\[cascade\\] casters: cascade \\d+, \\d+ frames;",
      "match": ", buffer full 0\\.0, added ",
      "min": 1,
      "windows": [
        "cost-cards-a",
        "cost-strands",
        "cost-cards-b",
        "cost-after-reload"
