      "min": 1,
      "windows": [
        "cost-cards-a",
        "cost-strands",
        "cost-cards-b",
        "cost-after-reload"
      ]
    },
    {
      "name": "opaque cutouts 0: no alpha-tested draw made opaque (region full 0.00) in every judged window",
      "select": "\\[geo\\] RT capture, last \\d+ frames:",
