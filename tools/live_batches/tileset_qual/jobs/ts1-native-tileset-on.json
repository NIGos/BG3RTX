      "windows": [
        "cost-on"
      ],
      "min": 1,
      "period_frames": 120
    },
    {
      "name": "GI GPU ms",
      "select": "gi: GPU cost",
      "match": "gi: GPU cost [0-9.]+ ms/frame",
      "windows": [
        "cost-on"
      ],
      "min": 1,
      "period_frames": 120
    },
    {
      "name": "GI coverage",
      "select": "rt stats \\(\\d+ frames\\): hybrid GI",
