  "expect_every": [
    {
      "name": "material table capacity",
      "select": "\\[hit material capacity\\] frame \\d+ ",
      "match": "opaque rows \\d+/\\d+ overflow 0; deferred rows \\d+/\\d+ overflow 0; samplers \\d+/\\d+ overflow 0; cache views \\d+/\\d+ overflow 0;.* tables \\d+/\\d+ overflow 0",
