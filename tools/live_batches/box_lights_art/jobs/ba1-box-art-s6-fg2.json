  "\\[motion-trace\\] phase=11 label=shot-off-b repeat=0",
  "\\[motion-trace\\] phase=12 label=shot-fixed-a repeat=0",
  "\\[motion-trace\\] phase=13 label=shot-off-c repeat=0",
  "\\[motion-trace\\] phase=14 label=shot-old-b repeat=0",
  "\\[motion-trace\\] phase=15 label=shot-off-d repeat=0",
  "\\[motion-trace\\] phase=16 label=shot-fixed-b repeat=0",
  "\\[motion-trace\\] phase=17 label=shot-off-e repeat=0",
  "\\[motion-plan\\] complete phases=19\\b",
