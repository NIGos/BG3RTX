    "turn-off-a-l",
    "turn-cam-r",
    "turn-cam-l",
    "turn-draw-r",
    "turn-draw-l",
    "turn-both-r",
    "turn-both-l",
    "turn-off-b-r",
    "turn-off-b-l"
   ],
   "period_frames": 120
  },
  {
   "name": "key state: header cameras copied on the GPU in the cam windows",
   "select": "\\[hair primary\\] header safety \\(last \\d+ frames\\)",
   "match": ", [1-9]\\d* header cameras copied on the GPU",
   "min": 1,
   "windows": [
    "turn-cam-r",
    "turn-cam-l",
    "turn-both-r",
    "turn-both-l"
   ],
   "period_frames": 120
  },
  {
   "name": "key state: the per-draw watchdog decides in the draw windows",
   "select": "\\[hair primary\\] header safety \\(last \\d+ frames\\)",
   "match": "\\(deciding: per draw\\)",
   "min": 1,
   "windows": [
    "turn-draw-r",
    "turn-draw-l",
    "turn-both-r",
    "turn-both-l"
   ],
   "period_frames": 120
  },
  {
   "name": "cam fix: 0 frame watchdog trips in the cam windows",
   "select": "\\[hair primary\\] header safety \\(last \\d+ frames\\)",
   "match": ", watchdog trips 0, ",
   "min": 1,
   "windows": [
    "turn-cam-r",
    "turn-cam-l",
    "turn-both-r",
    "turn-both-l"
   ],
   "period_frames": 120
  },
  {
   "name": "cam fix: 0 per-draw watchdog trips in the both windows",
   "select": "\\[hair primary\\] header safety \\(last \\d+ frames\\)",
   "match": "per-draw watchdog trips 0 ",
   "min": 1,
   "windows": [
    "turn-both-r",
    "turn-both-l"
   ],
   "period_frames": 120
  },
  {
   "name": "cam fix: no main-view hair draw kept as cards by the watchdog in the cam windows",
   "select": "\\[hair primary\\] frame \\d+: \\d+ grooms published",
   "match": "^(?!.*swap refusals[^;]*watchdog [1-9])",
   "min": 1,
   "windows": [
    "turn-cam-r",
    "turn-cam-l",
    "turn-both-r",
    "turn-both-l"
   ],
   "period_frames": 120
  },
  {
   "name": "cam fix: sampled strand ray origin 0 (header camera = G-buffer camera) in the cam windows",
   "select": "\\[hair primary\\] strand traces in counted frame \\d+:",
   "match": "origin \\(-?0\\.0000 -?0\\.0000 -?0\\.0000\\)",
   "min": 1,
   "windows": [
    "turn-cam-r",
    "turn-cam-l",
    "turn-both-r",
    "turn-both-l"
   ],
   "period_frames": 120
  },
  {
   "name": "cam fix: evidence strand share >= kCoverMin 0.891 in the cam windows",
   "select": "\\[hair primary\\] strand traces in counted frame \\d+:",
   "match": "evidence strand share (0\\.89[1-9]|0\\.9\\d\\d|1\\.\\d+)",
   "min": 1,
   "windows": [
    "turn-cam-r",
    "turn-cam-l",
    "turn-both-r",
    "turn-both-l"
   ],
   "period_frames": 120
  },
  {
   "name": "scene wait: 0 timeouts in every window",
   "select": "\\[rt\\] scene wait: \\d+ frames",
   "match": "got this frame's scene, 0 timeouts",
   "min": 1,
   "windows": [
    "turn-off-a-r",
    "turn-off-a-l",
    "turn-cam-r",
    "turn-cam-l",
    "turn-draw-r",
    "turn-draw-l",
    "turn-both-r",
    "turn-both-l",
    "turn-off-b-r",
    "turn-off-b-l"
   ],
   "period_frames": 120
  }
 ],
 "expect_runner": [
  "\\[window-mode\\].*visible_unfocused",
  "\\[wheel-input\\] phase=2 notches=10\\b",
  "\\[motion-plan\\] complete phases=14\\b",
  "^Run ended: done"
 ],
 "live_flow": {
