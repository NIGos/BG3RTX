{
 "name": "hk1-s8-shared-key",
 "save": "Water Queens House",
 "session": false,
 "traces": 0,
 "hold": 120,
 "timeout": 420,
 "max_minutes": 5,
 "repeat": 1,
 "live_batch": "hair-shared-key",
 "tree": ".claude/worktrees/test-main",
 "window_mode": "visible_unfocused_fg",
 "fail_fast": true,
 "stop_on_dump": false,
 "set": "preset=ultra,fg=3,headless=0,crash_dump=1,rt_timing_frames=120,rt_scene_wait_log_frames=120,rt_stats_period_frames=120,rt_debug=0,ls_debug=0,gi_debug=0,rf_debug=0,rr_show=0,rf_stats=0,ls_stats=0,ls_check=0,rt_stats=0,rt_primary_check=0,dump_images=0,dump_raw=0,dump_shaders=0,pan_capture=0,pan_inputs=0,pan_prepare=0,sharc=0,qa_exposure_hold=0,rt_alpha_floor_yield=0,rt_capture_rise_reserve=1,rt_capture_wide_split=1,rt_mesh_budget_own=0,rt_hair_header_cam_gpu=0,rt_hair_watchdog_draw=0,rt_hair_groom=1,rt_hair_groom_primary=1,rt_hair_groom_primary_order=1,rt_hair_groom_primary_current=1,rt_hair_primary_frame_tag=1,rt_hair_groom_lod_keep=1,rt_hair_primary_hold=1,rt_hair_tangent_world=1,rt_hair_groom_shadow_t=1,rt_hair_groom_ao_t=1,rt_hair_groom_cascade_drop=1,rt_hair_fibre=1,rt_hair_fibre_gi=1,rt_hair_fibre_spec=1,rt_hair_fibre_mapped=1,rr_hair_guides=1,rt_hair_physical_origin=1,rt_hair_capture=1,rr_hair_strand_aa=2,rt_hair_warmup=1,rt_hair_shared_key=0,rt_hair_watchdog_one_key=0",
 "args": [
  "-RealPresent",
  "-Move",
  "-MovePlan",
  "tools/live_batches_staged/hair_cam/plans/hk1_s8.json"
 ],
 "patterns": [
  "\\[auto\\]",
  "\\[cfg\\]",
  "\\[hot\\]",
  "\\[watch\\]",
  "\\[crash\\]",
  "FAILED",
  "\\[hair primary\\]",
  "\\[rt\\] scene wait",
  "rt passes: GPU cost",
  "\\[sl\\] DLSS-G frame",
  "\\[sl\\] warn",
  "VK_ERROR",
  "\\[log\\]",
  "\\[hair groom\\] frame \\d+: \\d+ groom instances"
 ],
 "expect": [
  "\\[auto\\] scene ready",
  "\\[hot\\] core generation \\d+ loaded",
  "\\[cfg\\] settings read",
  "\\[hair primary\\] header at 0x",
  "\\[hair primary\\] live: strands ON at frame \\d+",
  "\\[hair primary\\] header safety \\(last \\d+ frames\\).*frame watchdog spared to one key \\d+ \\(rt_hair_watchdog_one_key [01]\\)",
  "\\[hair groom\\] frame \\d+: \\d+ groom instances; last \\d+ frames.*shared-key rows withheld \\d+ \\(rt_hair_shared_key\\)"
 ],
 "forbid": [
  "\\[crash\\] exception 0x",
  "VK_ERROR_DEVICE_LOST",
  "\\[hot\\] core (rejected|faulted)",
  "FAILED, keeping previous",
  "compile call failed",
  "\\[log\\] reached \\d+ MB",
  "\\[hair primary\\] strand feedback unavailable",
  "\\[hair primary\\] UNAVAILABLE"
 ],
 "expect_every": [
  {
   "name": "baseline: the hc1 frame watchdog trips reproduce in each turn-off window (else the run proves nothing)",
   "select": "\\[hair primary\\] header safety \\(last \\d+ frames\\).*, watchdog trips [1-9]\\d*, ",
   "match": "",
   "min": 1,
   "windows": [
    "turn-off-r",
    "turn-off-l"
   ],
   "period_frames": 120,
   "event": true
  },
  {
   "name": "fix: 0 frame watchdog trips in every shared-key window",
   "select": "\\[hair primary\\] header safety \\(last \\d+ frames\\)",
   "match": ", watchdog trips 0, ",
   "min": 1,
   "windows": [
    "turn-shared-r",
    "turn-shared-l",
    "turn-both-r",
    "turn-both-l"
   ],
   "period_frames": 120
  },
  {
   "name": "fix: 0 dropouts in every shared-key window",
   "select": "\\[hair primary\\] dropouts \\(last \\d+ frames\\)",
   "match": "\\): 0 swapped G-buffer draws wrote",
   "min": 1,
   "windows": [
    "turn-shared-r",
    "turn-shared-l",
    "turn-both-r",
    "turn-both-l"
   ],
   "period_frames": 120
  },
  {
   "name": "report: dropouts count in every measured window",
   "select": "\\[hair primary\\] dropouts \\(last \\d+ frames\\)",
   "match": "\\): \\d+ swapped G-buffer draws wrote",
   "min": 1,
   "windows": [
    "static-on",
    "turn-off-r",
    "turn-off-l",
    "turn-shared-r",
    "turn-shared-l",
    "turn-both-r",
    "turn-both-l"
   ],
   "period_frames": 120
  },
  {
   "name": "report: shared-key rows withheld in every measured window",
   "select": "\\[hair groom\\] frame \\d+: \\d+ groom instances; last \\d+ frames",
   "match": "shared-key rows withheld \\d+ \\(rt_hair_shared_key\\)",
   "min": 1,
   "windows": [
    "static-on",
    "turn-off-r",
    "turn-off-l",
    "turn-shared-r",
    "turn-shared-l",
    "turn-both-r",
    "turn-both-l"
   ],
   "period_frames": 120
  },
  {
   "name": "key state: one-key watchdog on in the both windows",
   "select": "\\[hair primary\\] header safety \\(last \\d+ frames\\)",
   "match": "frame watchdog spared to one key \\d+ \\(rt_hair_watchdog_one_key 1\\)",
   "min": 1,
   "windows": [
    "turn-both-r",
    "turn-both-l",
    "static-on"
   ],
   "period_frames": 120
  },
  {
   "name": "key state: one-key watchdog off in the off and shared windows",
   "select": "\\[hair primary\\] header safety \\(last \\d+ frames\\)",
   "match": "frame watchdog spared to one key \\d+ \\(rt_hair_watchdog_one_key 0\\)",
   "min": 1,
   "windows": [
    "turn-off-r",
    "turn-off-l",
    "turn-shared-r",
    "turn-shared-l"
   ],
   "period_frames": 120
  },
  {
   "name": "key state: the frame watchdog decides (rt_hair_watchdog_draw 0)",
   "select": "\\[hair primary\\] header safety \\(last \\d+ frames\\)",
   "match": "\\(deciding: frame\\)",
   "min": 1,
   "windows": [
    "static-on",
    "turn-off-r",
    "turn-off-l",
    "turn-shared-r",
    "turn-shared-l",
    "turn-both-r",
    "turn-both-l"
   ],
   "period_frames": 120
  },
  {
   "name": "report: hair G-buffer draws strand/total in every measured window",
   "select": "\\[hair primary\\] frame \\d+: \\d+ grooms published",
   "match": "hair draws strand/total: main G-buffer \\d+/\\d+",
   "min": 1,
   "windows": [
    "static-on",
    "turn-off-r",
    "turn-off-l",
    "turn-shared-r",
    "turn-shared-l",
    "turn-both-r",
    "turn-both-l"
   ],
   "period_frames": 120
  },
  {
   "name": "scene wait: 0 timeouts in every window",
   "select": "\\[rt\\] scene wait: \\d+ frames",
   "match": "got this frame's scene, 0 timeouts",
   "min": 1,
   "windows": [
    "static-on",
    "turn-off-r",
    "turn-off-l",
    "turn-shared-r",
    "turn-shared-l",
    "turn-both-r",
    "turn-both-l"
   ],
   "period_frames": 120
  }
 ],
 "expect_runner": [
  "\\[window-mode\\].*visible_unfocused",
  "\\[wheel-input\\] phase=3 notches=10\\b",
  "\\[motion-plan\\] complete phases=11\\b",
  "^Run ended: done"
 ],
 "live_flow": {
  "expected_fps": 30,
  "settings_latency_s": 1,
  "trace_stall_s": 3
 },
 "estimated_phase_seconds": 160,
 "purpose": "RTX Hair shared draw key at S8 in the hc1 view and turns: rt_hair_shared_key and rt_hair_watchdog_one_key off / shared / both in one run (header_cam_gpu and watchdog_draw 0). Turn-off must reproduce the hc1 frame watchdog trips; shared-key windows: 0 trips and 0 dropouts per window."
}
