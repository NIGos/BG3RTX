float3 lsref_rt_ray_origin_o(float4 o, float3 P, float3 Ns, float foot, float3 dir) {
  float ss = dot(Ns, dir) < 0.0 ? -1.0 : 1.0;
  if (pc.rt_origin == 0u) return P + Ns * (length(P) * pc.rt_bias * ss);
