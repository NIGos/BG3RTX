// Surface terms of f469db78 at one pixel.
struct lsref_Bg3Surface {
  float3 P, N, V;
  float3 diff_col, f0;
  float a;        // roughness after the game's clamp and specular AA (_515)
  float nov_raw;  // _580
  float nov;      // _581
  uint channel;
  float ign;      // interleaved gradient noise of the atlas PCF (_556)
  float dist;
  float4 org;     // lsref_rt_origin_at(): this pixel's ray-origin data (rt_common.hlsli)
};

float lsref_bg3_pow5(float x) { return pow(max(abs(x), 9.9999997e-05), 5.0); }

// One light's unshadowed contribution: diffuse in .xyz of `d`, specular in `s`.
// Returns false when the game would not evaluate it (channel, range, cone, N.L).
// `k` is the light's scalar factor before the shadow, `nol` its N.L.
bool lsref_bg3_light_eval(lsref_Bg3Light l, bool spot, lsref_Bg3Surface sf, out float3 d, out float3 s, out float3 Ld,
                    out float d2, out float nol) {
  d = 0; s = 0; Ld = 0; d2 = 0; nol = 0;
  if ((l.chan & (1u << (sf.channel & 31u))) == 0u) return false;
  float3 L = l.pos - sf.P;
  d2 = dot(L, L);
  Ld = L * rsqrt(max(d2, 1.0000000e-10));
  float ir2 = l.inv_r * l.inv_r;
  if (!(d2 < 1.0 / ir2)) return false;
  float3 H0 = sf.V + Ld;
  float3 H = H0 * rsqrt(max(dot(H0, H0), 1.0000000e-10));
  float loh = saturate(dot(Ld, H));
  float noh = saturate(dot(sf.N, H));
  nol = saturate(dot(sf.N, Ld));
  float x = d2 * ir2;
  float att = pow(max(abs(saturate(1.0 - x * x)), 9.9999997e-05), l.m4);
  float bias = abs(l.m5);
  att *= l.m5 < 0.0 ? (4.0 * ir2 + bias) : (1.0 / max(d2, 9.9999997e-05) + bias);
  float k;
  if (spot) {
    float c = dot(-Ld, normalize(l.dir));
    if (!(c > l.cos_outer)) return false;
    float t = saturate((c - l.cos_outer) / max(l.cos_inner - l.cos_outer, 9.9999997e-05));
    k = 0.31830987 * (nol * (att * (t * t)));
  } else {
    k = 0.07957747 * (nol * att);
  }
  if (!(nol > 0.0)) return false;
  float3 col = l.col * (k * (l.m3 < 0.0 ? asfloat(lScale.Load(0)) : 1.0));
  float a = sf.a;
  float3 fd = (2.0 * loh * loh * a + lerp(0.0, 0.5, a)).xxx - 1.0;
  float k2 = (a + 1.0) * 0.5;
  k2 *= k2;
  float a4 = a * a;
  a4 *= a4;
  float dn = (noh * a4 - noh) * noh + 1.0;
  float3 F = sf.f0 + (1.0 - sf.f0) * lsref_bg3_pow5(1.0 - loh);
  float vis = 0.5 / (nol * sqrt((sf.nov - sf.nov * k2) * sf.nov + k2) + sf.nov * sqrt((nol - nol * k2) * nol + k2));
  s = col * (F * (vis * (a4 * (0.31830987 / (dn * dn)))));
  float burley = (1.0 + fd.x * lsref_bg3_pow5(1.0 - nol)) * (1.0 + fd.x * lsref_bg3_pow5(1.0 - sf.nov));
  d = col * (sf.diff_col * (0.31830987 * (burley * lerp(1.0, 0.66225165, a))));
  return true;
}

// The game's atlas shadow term for a light with m7 bit 0: tetrahedral face (points)
// or the single view (spots), 12-tap Vogel-disc PCF rotated by IGN, faded by the
// camera distance (b39 _m34) and the light's strength m8. 1 = lit.
float lsref_bg3_atlas_shadow(lsref_Bg3Light l, bool spot, lsref_Bg3Surface sf, float3 Ld, float d2, float nol) {
  uint slot = l.flags >> 2;
  if (!spot) {
    float3 m = -Ld;
    float f0 = dot(m, float3(0.0, -0.57735026, 0.81649661));
    float f1 = dot(m, float3(0.0, -0.57735026, -0.81649661));
    float f2 = dot(m, float3(-0.81649661, 0.57735026, 0.0));
    float f3 = dot(m, float3(0.81649661, 0.57735026, 0.0));
    float mx = max(max(f0, f1), max(f2, f3));
    slot += mx == f0 ? 0u : mx == f1 ? 1u : mx == f2 ? 2u : 3u;
  }
  float pcf = 0.0;
  if (!bg3_in(lShadows, slot, 96u)) return 1.0;   // (hand edit: the live guard, 53ab276)
  if (nol > 0.0) {
    uint a = slot * 96u;
    float4 r0 = asfloat(lShadows.Load4(a)), r1 = asfloat(lShadows.Load4(a + 16));
    float4 r2 = asfloat(lShadows.Load4(a + 32)), r3 = asfloat(lShadows.Load4(a + 48));
    float2 org = asfloat(lShadows.Load2(a + 64));
    float size = asfloat(lShadows.Load(a + 72));
    float nb = asfloat(lShadows.Load(a + 80));
    float2 dp = asfloat(lShadows.Load2(a + 84));
    float dw = asfloat(lShadows.Load(a + 92));
    float4 q = float4(sf.P + sf.N * ((3.5 * sign(nol)) * (nb * sqrt(d2))), 1.0);
    float4 c = float4(dot(r0, q), dot(r1, q), dot(r2, q), dot(r3, q));
    float3 p = c.xyz / c.w;
    float2 uv = p.xy * 0.5 + 0.5;
    uv.y = 1.0 - uv.y;
    float ref = (dp.y / dw) / (p.z - dp.x);
    float2 texel = lConsts.c[33].xy;
    float rot = sf.ign * 6.2831855;
    float2 lo = org + texel, hi = org + size.xx - texel;
    uint aw, ah;
    lAtlas.GetDimensions(aw, ah);
    int2 amax = int2(aw, ah) - 1;
    float sum = 0.0;
    [loop] for (int i = 0; i < 12; ++i) {
      float fi = float(i);
      float r = sqrt(fi + 0.5) * 0.28867513;
      float ang = fi * 2.3999631 + rot;
      float2 u = clamp(float2(cos(ang), sin(ang)) * r * 2.5 * texel + uv, lo, hi);
      float2 f = frac(u / texel + 0.5);
      // textureGather: x (i0, j1), y (i1, j1), z (i1, j0), w (i0, j0)
      int2 b = int2(floor(u / texel - 0.5));
      float g00 = lAtlas.Load(int3(clamp(b, 0, amax), 0));
      float g10 = lAtlas.Load(int3(clamp(b + int2(1, 0), 0, amax), 0));
      float g01 = lAtlas.Load(int3(clamp(b + int2(0, 1), 0, amax), 0));
      float g11 = lAtlas.Load(int3(clamp(b + int2(1, 1), 0, amax), 0));
      float4 cmp = float4(ref < g01, ref < g11, ref < g10, ref < g00);
      sum += saturate(lerp(lerp(cmp.w, cmp.z, f.x), lerp(cmp.x, cmp.y, f.x), f.y));
    }
    pcf = sum * 0.083333336;
  }
  float fade = saturate(lConsts.c[33].w * length(sf.P) + lConsts.c[33].z);
  return lerp(1.0, pcf, min(fade, l.strength));
}
// ---- bg3_materials.hlsli ----
// BG3's per-material-class local-light shading (RT2.a bits 0-2, gi_common.hlsli
// kMat*), replicated from the lighting permutations of captures/20261026-094651:
//   class 0 f469db78 (bg3_lights.hlsli), 2 4265b844 (anisotropic GGX),
//   3 118833ff (skin: dual-lobe GGX, diffuse colour 1, transmission),
//   4 19763259 (thin translucency), 5 3033c895 (Marschner hair),
//   6 95af6e4f (sheen cloth), 7 7f110c00 (GGX/sheen blend); 1 is skipped by the
//   lighting (702bda11). The mixed-tile permutations (953fb057, 8b781b6e, 4f4077b6,
//   49f89784, cb6d23ac, 7f110c00, 34a007cc) branch per pixel to the same terms.
// Used by rt_local_shadows.hlsl to get each light's exact unshadowed contribution.


struct lsref_Bg3Mat {
  uint cls;
  float4 rt3;
  // skin (3) and thin translucency (4)
  bool trans;       // a transmission lobe (3: RT3.w != 0; 4: always)
  bool thick_sm;    // profile m2.z == 1: thickness from the shadow map instead of the shadow
  bool dual;        // skin: two GGX lobes
  float r0, r1, lobe_mix, metal;
  float3 inv_sc, tint;
  float base_thick;
  // anisotropic (2) and hair (5)
  float3 T;
  float aniso;
  float hair_rough, backlit, scatter;
  float3 albedo;
};

// 12:12 octahedral vector in RT3.xyz (4265b844:349, 3033c895:344).
float3 lsref_bg3_oct12(float3 rt3) {
  float3 b = rt3 * 255.0;
  float h = b.y * 0.0625;
  float2 e = clamp(float2(b.x * 16.0 + floor(h), frac(h) * 4096.0 + b.z) * 0.00048851978 - 1.0, -1.0, 1.0);
  float z = (1.0 - abs(e.x)) - abs(e.y);
  float2 sg = float2(e.x >= 0.0 ? 1.0 : -1.0, e.y >= 0.0 ? 1.0 : -1.0);
  float2 xy = z >= 0.0 ? e : (1.0 - abs(e.yx)) * sg;
  return normalize(float3(xy, z));
}

// Per-class inputs and the surface terms that differ from class 0. `sf` arrives set up
// as for class 0 (diff_col = albedo (1 - metal), f0, a with specular AA). `nrot`: the
// _m6 rotation the normal got (anisotropic tangents get it, hair tangents do not).
lsref_Bg3Mat lsref_bg3_mat_setup(uint cls, float3 albedo, float4 mat, float4 rt3, bool skin_white, float3x3 nrot,
                     inout lsref_Bg3Surface sf) {
  lsref_Bg3Mat m = (lsref_Bg3Mat)0;
  m.cls = cls;
  m.rt3 = rt3;
  m.albedo = albedo;
  if (cls == 3u || cls == 4u) {
    // The profile list's size varies with the area: never read past its end.
    uint bytes;
    lSssProfiles.GetDimensions(bytes);
    uint a = min(uint(int(rt3.x * 255.0)) * 64u, bytes >= 64u ? bytes - 64u : 0u);
    float4 p0 = asfloat(lSssProfiles.Load4(a)), p1 = asfloat(lSssProfiles.Load4(a + 16));
    float4 p2 = asfloat(lSssProfiles.Load4(a + 32)), p3 = asfloat(lSssProfiles.Load4(a + 48));
    float R0 = max(0.09, mat.x);   // before specular AA (118833ff:373)
    m.metal = mat.z;
    m.dual = cls == 3u;
    if (m.dual && skin_white) sf.diff_col = (1.0 - mat.z).xxx;   // 118833ff:371
    m.r0 = max(saturate(p3.x * R0), 0.09);
    m.r1 = max(saturate(p3.y * R0), 0.09);
    m.lobe_mix = p3.z;
    m.trans = m.dual ? rt3.w != 0.0 : true;
    m.thick_sm = p2.z == 1.0;
    m.inv_sc = 1.0 / max(p0.xyz * 0.09660940 * (p0.w * (m.dual ? rt3.y : 1.0)), 9.9999997e-05.xxx);
    m.tint = p1.xyz;
    m.base_thick = p2.y * rt3.z + p2.x;
  } else if (cls == 2u) {
    m.T = mul(lsref_bg3_oct12(rt3.xyz), nrot);   // rotated like the normal (4265b844:356)
    m.aniso = rt3.w;
  } else if (cls == 5u) {
    m.T = lsref_bg3_oct12(rt3.xyz);              // not rotated (3033c895:351), sic
    m.hair_rough = max(0.09, mat.x);       // no specular AA
    m.backlit = mat.z;
    m.scatter = rt3.w;
    sf.diff_col = albedo;                  // metalness forced to 0
  } else if (cls == 6u) {
    sf.diff_col = albedo;                  // raw albedo, RT2.y/z unused (95af6e4f:340)
  }
  return m;
}

// ---- lobes ----
float lsref_bg3_ggx_D(float noh, float a) {
  float a4 = a * a;
  a4 *= a4;
  float dn = (noh * a4 - noh) * noh + 1.0;
  return a4 * (0.31830987 / (dn * dn));
}

// Skin: two GGX lobes from the profile, roughness lerped to the AA'd one by metalness (118833ff:625).
float lsref_bg3_sss_D(float noh, float a, lsref_Bg3Mat m) {
  float a2 = a * a;
  float l0 = lerp(m.r0 * m.r0, a2, m.metal), l1 = lerp(m.r1 * m.r1, a2, m.metal);
  float q0 = l0 * l0, q1 = l1 * l1;
  float d0 = (noh * q0 - noh) * noh + 1.0, d1 = (noh * q1 - noh) * noh + 1.0;
  return lerp(q0 * (0.31830987 / (d0 * d0)), q1 * (0.31830987 / (d1 * d1)), m.lobe_mix);
}

// Anisotropic GGX (4265b844:548).
float lsref_bg3_aniso_D(float noh, float toh, float a, float aniso) {
  float a2 = a * a;
  float s = sqrt(1.0 - aniso * 0.89999998);
  float ax = max(0.001, saturate(a2 / s));
  float ay = max(0.001, a2 * s);
  float q = noh * noh + ((toh * toh) / (ax * ax) + ((1.0 - toh * toh) - noh * noh) / (ay * ay));
  return 1.0 / (((ax * ay) * 3.1415927) * q * q);
}

// Charlie sheen D x Neubelt visibility (95af6e4f:527).
float lsref_bg3_sheen(float noh, float nol, float nov, float a) {
  float D = ((2.0 + 1.0 / a) * pow(max(abs(1.0 - noh * noh), 9.9999997e-05), 0.5 / a)) * 0.15915494;
  float nv = saturate(nov);
  return D * (0.25 / (nol + nv - nol * nv));
}

// Skin/translucency transmittance through `thick` (118833ff:580).
float3 lsref_bg3_sss_T(lsref_Bg3Mat m, float thick) {
  float3 e = exp2(m.inv_sc * (-0.48089835 * thick));
  return m.tint * (e * (e * e + 3.0));
}
float lsref_bg3_sss_wrap(float nol_raw) { return saturate((0.25881907 - nol_raw) * 0.63106394); }

// UE4-style Marschner R + TT + TRT (3033c895:515).
float3 lsref_bg3_hair_spec(lsref_Bg3Mat h, float3 L, float3 V) {
  float sl = clamp(dot(h.T, L), -1.0, 1.0), sv = clamp(dot(h.T, V), -1.0, 1.0);
  float ctd = cos(0.5 * abs(asin(sv) - asin(sl)));
  float3 lp = L - h.T * sl, vp = V - h.T * sv;
  float cphi = dot(lp, vp) * rsqrt(dot(lp, lp) * dot(vp, vp) + 9.9999997e-05);
  float chp = sqrt(saturate(0.5 * cphi + 0.5));
  float r2 = h.hair_rough * h.hair_rough;
  float3 B = float3(r2 * (1.4142135 * chp), r2 * 0.5, r2 * 2.0);
  float3 sh = float3(-0.13988569 * (0.99755102 * chp * sqrt(1.0 - sv * sv) + -0.069942847 * sv), 0.035, 0.14);
  float3 t = max(abs((sl + sv).xxx - sh), 9.9999997e-05);
  float3 Mp = exp((t * t) * -0.5 / (B * B)) / (B * 2.5066283);
  float vol = dot(V, L);
  float fR = 0.046520568 + 0.95347941 * lsref_bg3_pow5(1.0 - sqrt(saturate(0.5 * vol + 0.5)));
  float R = 0.25 * chp * fR * lerp(1.0, h.backlit, saturate(-vol)) * Mp.x;
  float ia = 1.0 / (0.36 * ctd + 1.19 / ctd);
  float hh = chp * (ia * (-0.8 * cphi + 0.6) + 1.0);
  float3 base = max(abs(h.albedo), 9.9999997e-05);
  float ft = 0.046520568 + 0.95347941 * lsref_bg3_pow5(1.0 - ctd * sqrt(saturate(1.0 - hh * hh)));
  float hx = max(abs(hh * ia), 9.9999997e-05);
  float3 TT = pow(base, (0.5 * sqrt(1.0 - hx * hx) / ctd).xxx) *
              (exp(-3.65 * cphi - 3.98) * pow(max(abs(1.0 - ft), 9.9999997e-05), 2.0)) * h.backlit * Mp.y;
  float f3 = 0.046520568 + 0.95347941 * lsref_bg3_pow5(1.0 - 0.5 * ctd);
  float3 TRT = pow(base, (0.8 / ctd).xxx) * (exp(17.0 * cphi - 16.78) * (pow(max(abs(1.0 - f3), 9.9999997e-05), 2.0) * f3)) * Mp.z;
  return R.xxx + TT + TRT;
}

// Hair scatter diffuse (3033c895:517); texp = 1 - S.
float3 lsref_bg3_hair_diff(lsref_Bg3Mat h, float nl, float tl, float texp) {
  float k = 0.31830987 * lerp(saturate((nl + 1.0) * 0.25), 1.0 - abs(tl), 0.33000001) * h.scatter;
  float3 tint = pow(max(abs(h.albedo / dot(h.albedo, float3(0.30000001, 0.58999997, 0.11))), 9.9999997e-05), texp.xxx);
  return sqrt(h.albedo) * k * tint;
}

// One light's exact unshadowed contribution for the pixel's class, the counterpart of
// lsref_bg3_light_eval (identical for class 0).
//   d:  diffuse the light's shadow multiplies (reflected, plus the transmission of
//       profiles that use the shadow);
//   dt: transmission the shadow does not multiply (profiles that take the thickness
//       from the shadow map instead, m2.z == 1);
//   s:  specular. nol: the UNCLAMPED N.L (its sign says from which side the light comes).
// Returns false when the game adds nothing for this light.
bool lsref_bg3_light_eval_mat(lsref_Bg3Light l, bool spot, lsref_Bg3Surface sf, lsref_Bg3Mat m, out float3 d, out float3 dt, out float3 s,
                        out float3 Ld, out float d2, out float nol) {
  d = 0; dt = 0; s = 0; Ld = 0; d2 = 0; nol = 0;
  if ((l.chan & (1u << (sf.channel & 31u))) == 0u) return false;
  float3 L = l.pos - sf.P;
  d2 = dot(L, L);
  Ld = L * rsqrt(max(d2, 1.0000000e-10));
  float ir2 = l.inv_r * l.inv_r;
  if (!(d2 < 1.0 / ir2)) return false;
  float x = d2 * ir2;
  float att = pow(max(abs(saturate(1.0 - x * x)), 9.9999997e-05), l.m4);
  float bias = abs(l.m5);
  att *= l.m5 < 0.0 ? (4.0 * ir2 + bias) : (1.0 / max(d2, 9.9999997e-05) + bias);
  float g, norm;
  if (spot) {
    float c = dot(-Ld, normalize(l.dir));
    if (!(c > l.cos_outer)) return false;
    float t = saturate((c - l.cos_outer) / max(l.cos_inner - l.cos_outer, 9.9999997e-05));
    g = att * (t * t);
    norm = 0.31830987;
  } else {
    g = att;
    norm = 0.07957747;
  }
  const float sc = l.m3 < 0.0 ? asfloat(lScale.Load(0)) : 1.0;
  nol = dot(sf.N, Ld);

  if (m.cls == 5u) {   // hair: no N.L gate; self-shadow S in place of N.L for lights without a shadow map
    float S = saturate(2.0 * nol + 0.5);
    if (!(S > 0.0)) return false;
    float3 col = l.col * ((norm * g) * S * sc);
    s = col * lsref_bg3_hair_spec(m, Ld, sf.V);
    d = col * lsref_bg3_hair_diff(m, nol, dot(m.T, Ld), 1.0 - S);
    return true;
  }

  bool any_t = false;
  if ((m.cls == 3u || m.cls == 4u) && m.trans) {   // transmission, also for N.L <= 0 (118833ff:580-606)
    float w = lsref_bg3_sss_wrap(nol);
    if (w > 0.0) {
      float3 tk = l.col * sf.diff_col * (0.31830987 * (norm * (w * g)) * sc);
      float3 tt = tk * lsref_bg3_sss_T(m, m.base_thick);
      if (m.thick_sm) dt = tt;
      else d = tt;
      any_t = true;
    }
  }
  const float nolc = saturate(nol);
  if (!(nolc > 0.0)) return any_t;
  float3 col = l.col * ((norm * (nolc * g)) * sc);
  float3 H0 = sf.V + Ld;
  float3 H = H0 * rsqrt(max(dot(H0, H0), 1.0000000e-10));
  float loh = saturate(dot(Ld, H));
  float noh = saturate(dot(sf.N, H));
  float a = sf.a;
  float fd = (2.0 * loh * loh * a + lerp(0.0, 0.5, a)) - 1.0;
  float burley = (1.0 + fd * lsref_bg3_pow5(1.0 - nolc)) * (1.0 + fd * lsref_bg3_pow5(1.0 - sf.nov));
  d += col * (sf.diff_col * (0.31830987 * (burley * lerp(1.0, 0.66225165, a))));

  float3 ggx = 0;
  if (m.cls != 6u) {
    float k2 = (a + 1.0) * 0.5;
    k2 *= k2;
    float3 F = sf.f0 + (1.0 - sf.f0) * lsref_bg3_pow5(1.0 - loh);
    float vis = 0.5 / (nolc * sqrt((sf.nov - sf.nov * k2) * sf.nov + k2) + sf.nov * sqrt((nolc - nolc * k2) * nolc + k2));
    float D = m.cls == 3u ? lsref_bg3_sss_D(noh, a, m) : m.cls == 2u ? lsref_bg3_aniso_D(noh, dot(H, m.T), a, m.aniso) : lsref_bg3_ggx_D(noh, a);
    ggx = F * (vis * D);
  }
  if (m.cls == 6u || m.cls == 7u) {
    float3 sheen = m.rt3.rgb * lsref_bg3_sheen(noh, nolc, sf.nov, a);
    s = col * (m.cls == 7u ? ggx * m.rt3.w + sheen * (1.0 - m.rt3.w) : sheen);
  } else {
    s = col * ggx;
  }
  return true;
}
// ---- bg3_sun.hlsli ----
// BG3's sun term, replicated from the tiled lighting (f469db78:1345-1452 class 0;
// the class variants from 4265b844, 118833ff, 19763259, 3033c895, 95af6e4f, 7f110c00),
// so that the D-LS post pass knows the sun's direct light exactly and can give
// it the AO-on-direct factor that ao_direct asks for (docs/archive/AUDIT_RT.md fix 4).
//
// sun radiance = colour (per frame: _m2, or the atmosphere's transmittance LUT)
//              x mask (b7, after our RT fold) x cloud shadows (two layers) x b13[0].
// Needs gi_common.hlsli (cam = set 0 b1), bg3_lights.hlsli and bg3_materials.hlsli.

struct lsref_AtmoCB { float4 a; };   // set 5 b0 (scalar): .x planet radius, .y atmosphere top radius
// Set 2 of the D-LS layout (an ordinary descriptor set, core/gi.cpp write_sun_set).

// The camera CB (set 0 b1, std140) fields past _m7: cam.x[i] = bytes 160 + 16 i.
//   x[0] _m8, x[1] _m9, x[2] _m10-_m13, x[3] _m14-_m17, x[4] _m18, x[5] _m19-_m22, x[6] _m23,
//   x[7] _m24 (xyz) _m25 (w), x[8] _m26 _m27, x[9] _m28, x[10] _m29 _m30, x[11] _m31,
//   x[12] _m32 _m33, x[13] _m34 _m35, x[14] _m36 _m37.
float3 lsref_bg3_cam_pos() { return cam2.c[13].xyz; }   // set 0 b2 _m6 (std140 offset 208)

// The sun's colour this frame (f469db78:1347-1373).
float3 lsref_bg3_sun_colour() {
  if (cam.x[5].x > 0.0 && cam.x[13].w == 0.0) {
    float R = lAtmo.a.x, Rt = lAtmo.a.y;
    float3 c = float3(0.0, 636100.0, 0.0) + lsref_bg3_cam_pos();
    float l = length(c);
    if (l < 0.89999998 * R) {
      c.z += R;
      l = length(c);
    }
    float mu = dot(c / l, cam.x[14].xyz);
    float r = R / l;
    float2 uv = float2(atan((mu + 0.15000001) * 12.262105) * 0.66666669, sqrt((l - R) / (Rt - R)));
    float3 t = lTransLut.SampleLevel(lLinearClamp, uv, 0.0).xyz;
    if (mu < -sqrt(max(1.0 - r * r, 0.0))) t = 0.0;
    return t * (cam.x[13].xyz * cam.x[5].y);
  }
  return cam.v1.xyz;
}

float2 lsref_bg3_cloud_uv(float3 W, float4 p, float h, float3 dir, float3 shift) {
  float3 a = float3(0.0, p.z, 0.0) + ((shift + W) - float3(0.0, h, 0.0));
  float b = dot(a, dir);
  float2 uv = (((a + dir * (sqrt(b * b + (p.z * p.z - dot(a, a))) - b)).xz * p.w) * 0.5 + 0.5) + p.xy;
  uv.x = 1.0 - uv.x;
  return uv;
}

// Both cloud-shadow factors at lighting-space position P (f469db78:1384-1421).
float lsref_bg3_cloud_shadow(float3 P) {
  float3 W = lsref_bg3_cam_pos() + P;
  float f = 1.0;
  if (cam.x[5].z > 0.0) {   // _m21
    float2 u0 = lsref_bg3_cloud_uv(W, cam.x[4], cam.x[7].w, cam.x[7].xyz, 0.0.xxx);
    float2 u1 = lsref_bg3_cloud_uv(W, cam.x[6], cam.x[8].w, cam.x[8].xyz, 0.0.xxx);
    float v = lerp(lCloudA0.SampleLevel(lLinearClamp, u0, 0.0).x, lCloudA1.SampleLevel(lLinearClamp, u1, 0.0).x, cam.x[3].z);
    f *= 1.0 - saturate(smoothstep(0.050000001, 0.55000001, v) * cam.x[5].z);
  }
  if (cam.x[3].w > 0.0) {   // _m17
    float2 u0 = lsref_bg3_cloud_uv(W, cam.x[9], cam.x[10].w, cam.x[7].xyz, cam.x[10].xyz);
    float2 u1 = lsref_bg3_cloud_uv(W, cam.x[11], cam.x[12].w, cam.x[8].xyz, cam.x[12].xyz);
    float v = lerp(lCloudB0.SampleLevel(lLinearClamp, u0, 0.0).x, lCloudB1.SampleLevel(lLinearClamp, u1, 0.0).x, cam.x[3].z);
    f *= 1.0 - saturate(v * cam.x[3].w);
  }
  return f;
}

// The sun's direct diffuse `d` and specular `s` for the pixel's class, given the
// radiance `col` (colour x mask x clouds x b13[0]; S = mask x clouds), before the
// AO-on-direct factor.
// Transmission (skin with profiles that use the shadow, thin translucency) is in d;
// thickness profiles (m2.z == 1) take theirs from the cascades and are left out.
void lsref_bg3_sun_eval_mat(lsref_Bg3Surface sf, lsref_Bg3Mat m, float3 Ls, float3 col, float S, out float3 d, out float3 s) {
  d = 0;
  s = 0;
  const float nl_raw = dot(sf.N, Ls);
  if (m.cls == 5u) {   // hair: no disc, no N.L (3033c895:1739-1773)
    s = col * lsref_bg3_hair_spec(m, Ls, sf.V);
    d = col * lsref_bg3_hair_diff(m, nl_raw, dot(m.T, Ls), 1.0 - S * S);   // tint exponent 1 - S^2 (3033c895:1772)
    return;
  }
  const float a = sf.a;
  const float nols = saturate(nl_raw);
  float lohs = saturate(dot(Ls, normalize(sf.V + Ls)));
  float fd = (2.0 * lohs * lohs * a + lerp(0.0, 0.5, a)) - 1.0;
  float burley = (1.0 + fd * lsref_bg3_pow5(1.0 - nols)) * (1.0 + fd * lsref_bg3_pow5(1.0 - sf.nov));
  d = col * (sf.diff_col * (0.31830987 * (burley * lerp(1.0, 0.66225165, a)))) * nols;
  if ((m.cls == 3u || m.cls == 4u) && m.trans && !m.thick_sm)
    d += lsref_bg3_sss_T(m, m.base_thick) * (col * lsref_bg3_sss_wrap(nl_raw)) * (sf.diff_col * 0.31830987);
  // Specular: the representative point of the sun's disc, as the game builds it
  // (reflect(V, N), sic; f469db78:1424-1428).
  float3 R = reflect(sf.V, sf.N);
  float rl = dot(Ls, R);
  float3 Lp = rl < 0.99998945 ? normalize(Ls * 0.99998945 + normalize(R - Ls * rl) * 0.0045900648) : R;
  float3 Hp = normalize(sf.V + Lp);
  float nohp = saturate(dot(sf.N, Hp)), nolp = saturate(dot(sf.N, Lp)), lohp = saturate(dot(Lp, Hp));
  float3 ggx = 0;
  if (m.cls != 6u) {
    float k2 = (a + 1.0) * 0.5;
    k2 *= k2;
    float3 F = sf.f0 + (1.0 - sf.f0) * lsref_bg3_pow5(1.0 - lohp);
    float vis = 0.5 / (nolp * sqrt((sf.nov - sf.nov * k2) * sf.nov + k2) + sf.nov * sqrt((nolp - nolp * k2) * nolp + k2));
    float D = m.cls == 3u ? lsref_bg3_sss_D(nohp, a, m) : m.cls == 2u ? lsref_bg3_aniso_D(nohp, dot(Hp, m.T), a, m.aniso) : lsref_bg3_ggx_D(nohp, a);
    ggx = F * (vis * D);
  }
  if (m.cls == 6u || m.cls == 7u) {   // x N.L' (95af6e4f:1521, 7f110c00:2873)
    float3 sheen = m.rt3.rgb * lsref_bg3_sheen(nohp, nolp, sf.nov, a);
    s = col * (m.cls == 7u ? ggx * m.rt3.w + sheen * (1.0 - m.rt3.w) : sheen) * nolp;
  } else {
    s = col * ggx * nols;
  }
}
// ---- rt_local_shadows.hlsl ----
// Track D, D-LS: ray-traced shadows for BG3's local point and spot lights
// (rt_local_shadows=1; docs/TRACK_D_RT.md section 9).
//
// Runs at full resolution right after the tiled lighting (before the GI
// composite, SSS and fog). For every point/spot light the game evaluated at
// this pixel (same froxel walk, channel mask, range and cone as f469db78), the
// unshadowed contribution c_i (diffuse and specular, the game's exact BRDF) is
// recomputed, and the exact delta
//     out += sum_i c_i * (v_i - s_i) * AO-on-direct factor
// is added into the game's diffuse/specular buffers, where s_i is the game's
// own shadow term (1 for lights without a shadow map, the atlas PCF for the
// others) and v_i the ray-traced visibility. Lights the game does not shadow
// can then only lose light (leaks through walls and floors), never gain any.
//
// Lights that have a game shadow map (ls_shadowed):
//   0 (default) left alone: the atlas also holds casters that are not on screen,
//     which the TLAS lacks (cut-away roofs, culled walls), so replacing it could
//     un-shadow them;
//   1 replace the atlas with the ray-traced visibility;
//   2 min(traced, atlas).
//
// Sampling: with RR (rr=1) and ls_source_radius > 0, one ray per light and pixel
// towards a uniform point of the light's sphere (solid angle), white noise from
// pcg3d keyed by (pixel, frame, light): RR denoises the penumbra. Without RR
// (no denoiser), one deterministic ray to the light centre (hard shadows).
// ls_samples > 0 instead traces that many rays per pixel to lights chosen by
// RIS over the unshadowed luminance (unbiased, noisier, cheaper with many lights).
//
// Per-light data (ls_lights=1, ls_flags bit 0; docs/SE_BRIDGE.md): lsSlots holds, per
// light array slot, what rt_local_shadows_match.hlsl joined to it from the Script
// Extender bridge or the asset database: the light's source radius (from its fixture
// class) and its owner. Lights of an owner whose bit is clear in ls_flags bits 8-12
// (ls_owners; default: not the character lights) are left as the game lit them.
// Unmatched lights keep ls_source_radius and are traced as before.
//
// Validation (ls_debug=4/5/6): rt_local_shadows_prep.hlsl zeroes the game's AO and
// sun mask before the lighting, so its output holds only direct local light (plus
// projector lights and in-scatter, which are not recomputed).


float lsref_lum(float3 c) { return dot(c, float3(0.2126, 0.7152, 0.0722)); }

// ls_debug=9: owner colours (unmatched red, placed white, item orange, scenery green,
// character magenta, unknown visual light cyan).
float3 lsref_owner_colour(uint owner, bool matched) {
  if (!matched) return float3(1, 0, 0);
  return owner == 1u ? float3(1, 1, 1) : owner == 2u ? float3(1, 0.5, 0) : owner == 3u ? float3(0, 1, 0)
       : owner == 4u ? float3(1, 0, 1) : float3(0, 1, 1);
}

uint3 lsref_ls_rand(uint2 fp, uint key) { return pcg3d(uint3(fp, pc.frame * 1024u + (key & 1023u))); }
float lsref_u01(uint x) { return float(x >> 8) * (1.0 / 16777216.0); }

// Lanes' sum of v added to counter `index` (fixed point), spread over 64 bins.
void lsref_stat_addv(uint index, uint v, uint bin) {
  uint n = WaveActiveSum(v);
  uint b = WaveReadLaneFirst(bin) & 63u;
  if (WaveIsFirstLane() && n) rtStats.InterlockedAdd((index * 64 + b) * 4, n);
}
uint lsref_fx(float v) { return uint(clamp(v, 0.0, 64.0) * 256.0 + 0.5); }

float3 lsref_n_world(float3 nv) { return nv.x * cam.m6_r0.xyz + nv.y * cam.m6_r1.xyz + nv.z * cam.m6_r2.xyz; }
float3 lsref_n_view_at(int2 p) { return decode_normal(gNormal.Load(int3(clamp(p, int2(0, 0), int2(pc.full) - 1), 0)).xy); }
float3 lsref_nan0(float3 v) { return any(isnan(v)) ? float3(0, 0, 0) : v; }

// Visibility of the light from the surface: 1 ray, towards the centre or a
// point of its sphere. `key` selects the random stream. `side` < 0: the light is
// behind the surface (transmission, hair), so the ray starts on the back side.
// (hand edit: returns the tri-state of lsref_rt_occluded)
uint lsref_trace_light(lsref_Bg3Surface sf, float3 lpos, uint2 fp, uint key, lsref_RtCone cone, float side, float R) {
  float3 L = lpos - sf.P;
#ifdef RT_HAIR_PHYSICAL_ORIGIN
  float3 receiver;bool physical_receiver=rt_hair_receiver(fp,sf.P,receiver);
  if(physical_receiver)L=lpos-receiver;
#endif
  float dist = length(L);
  float3 Ld = L / max(dist, 1e-6);
  float3 dir = Ld;
  if (pc.ls_soft != 0 && R > 0.0) {
    uint3 r = lsref_ls_rand(fp, key);
    float sin_max = min(R / max(dist, 1e-6), 1.0);
    float cos_max = sqrt(max(1.0 - sin_max * sin_max, 0.0));
    float ct = 1.0 - lsref_u01(r.x) * (1.0 - cos_max);
    float st = sqrt(max(1.0 - ct * ct, 0.0));
    float phi = 6.2831853 * lsref_u01(r.y);
    float3 t = abs(Ld.y) < 0.99 ? normalize(cross(float3(0, 1, 0), Ld)) : float3(1, 0, 0);
    float3 b = cross(Ld, t);
    dir = normalize(Ld * ct + (t * cos(phi) + b * sin(phi)) * st);
  }
  // (`side` < 0 gives the ray a direction below the surface: the origin follows it.)
  float3 o = lsref_rt_ray_origin_o(sf.org, sf.P, sf.N, cone.f0, dir);
#ifdef RT_HAIR_PHYSICAL_ORIGIN
  o=rt_secondary_ray_origin_o(fp,sf.org,sf.P,sf.N,cone.f0,dir); // hand edit: shared physical receiver geometry only
#endif
  float tmax = length(lpos - o) - max(R, pc.ls_clear);
#ifdef RT_HAIR_PHYSICAL_ORIGIN
  if(physical_receiver){
    HairLightSegment segment=hpo_light_segment(receiver,o,lpos,dir,pc.ls_soft!=0?R:0.0,pc.ls_soft!=0?pc.ls_clear:max(R,pc.ls_clear));
    if(!segment.valid)return kRtUnknown;dir=segment.direction;tmax=segment.tmax;
  }
#endif
  if (tmax <= 0.0) return kRtLit;
  return lsref_rt_occluded(o, dir, tmax, cone);
}


bool lsref_ls_ref(uint2 fp, inout float3 o_d, inout float3 o_s) {
  if (any(fp >= pc.full)) return false;
  g_rt_pass = kRtPassLocal;   // (hand edit: unknown-query count)
  // (hand edit: the QA ambient floor, qa_zero bit 1, as rt_local_shadows.hlsl does it)
  const bool qa = (pc.qa_zero & 2u) != 0u;
  float d = gDepth.Load(int3(fp, 0));

  if (d <= 0.0) return false;

  // ---- the surface, exactly as f469db78 sets it up ----
  lsref_Bg3Surface sf;
  float2 uv = (float2(fp) + 0.5) / float2(lFlags.res);
  sf.P = ray_at(uv) * d;
  sf.dist = length(sf.P);
  float3 nv = decode_normal(gNormal.Load(int3(fp, 0)).xy);
  sf.N = lsref_n_world(nv);
  sf.V = normalize(-sf.P);
  float4 alb = gAlbedo.Load(int3(fp, 0));
  float4 mat = gMaterial.Load(int3(fp, 0));
  // The lighting skips unlit pixels: no light to remove.
  uint cls = mat_class_at(fp);
  if (cls == kMatUnlit) return false;
  // Classes whose parameters are missing are shaded as class 0 (logged by the core).
  if ((cls == kMatSkin || cls == kMatTranslucent) && (pc.mat_classes & 4u) == 0u) cls = kMatStandard;
  if (cls >= kMatAniso && (pc.mat_classes & 2u) == 0u) cls = kMatStandard;
  float4 rt3 = cls != kMatStandard ? gRT3.Load(int3(fp, 0)) : 0.0.xxxx;
  sf.channel = (uint(round(mat.w * 255.0)) & 112u) >> 4;
  sf.diff_col = alb.rgb * (1.0 - mat.z);
  sf.f0 = lerp((0.16 * mat.y * mat.y).xxx, alb.rgb, mat.z);
  // Specular AA from the quad's normal differences (n(odd) - n(even) in each direction).
  int2 q0 = int2(fp & ~1u);
  float3 dh = lsref_nan0(lsref_n_view_at(int2(q0.x + 1, fp.y)) - lsref_n_view_at(int2(q0.x, fp.y)));
  float3 dv = lsref_nan0(lsref_n_view_at(int2(fp.x, q0.y + 1)) - lsref_n_view_at(int2(fp.x, q0.y)));
  float r = max(0.09, mat.x);
  sf.a = sqrt(saturate(r * r + min(dot(dh, dh) + dot(dv, dv), 0.18)));
  sf.nov_raw = dot(sf.N, sf.V);
  sf.nov = max(sf.nov_raw, 9.9999997e-06);
  sf.ign = frac(52.982918 * frac(0.06711056 * float(fp.x) + 0.0058371499 * float(fp.y)));
  sf.org = lsref_rt_origin_at(fp);
  const lsref_Bg3Mat mt = lsref_bg3_mat_setup(cls, alb.rgb, mat, rt3, skin_white(),
                                  float3x3(cam.m6_r0.xyz, cam.m6_r1.xyz, cam.m6_r2.xyz), sf);

  float pa = pixel_angle(uv);
  lsref_RtCone cone = {sf.dist * pa, pa};
  const bool validate = pc.ls_debug >= 4 && pc.ls_debug <= 7;

  uint3 cl = lsref_bg3_cluster(fp, d);
  uint end_p = cl.x + cl.y, end_s = end_p + cl.z;
  float3 dd = 0, ds = 0;          // delta diffuse / specular
  float3 md = 0, ms = 0;          // validation: recomputed lighting with the game's shadows
  float3 cd_all = 0, cs_all = 0;  // debug: unshadowed sum of the traced lights
  float3 vd_all = 0;              // debug: traced-visible part
  float3 td = 0, ts = 0;          // direct light of the traced lights after our shadow (ao_direct)
  uint n_lights = 0, n_shadowed = 0, n_traced = 0, n_occ = 0;
  uint n_matched = 0, n_se = 0, n_skipped = 0, n_unmatched = 0;   // per-light data (ls_stats)
  float3 dbg_owner = 0;                                            // ls_debug=9
  // RIS reservoirs (ls_samples > 0)
  const uint ns = qa ? 0u : min(pc.ls_samples, 2u);
  float wsum = 0;
  float3 rd[2] = {float3(0, 0, 0), float3(0, 0, 0)}, rs[2] = {float3(0, 0, 0), float3(0, 0, 0)}, rp[2] = {float3(0, 0, 0), float3(0, 0, 0)};
  float rw[2] = {0, 0}, rsh[2] = {1, 1}, rsel[2] = {0, 0}, rside[2] = {1, 1}, rR[2] = {0, 0};
  uint rk[2] = {0, 0};

  for (uint i = cl.x; i < end_s; ++i) {
    uint li = lIndex.Load(i * 4u);
    bool spot = i >= end_p;
    lsref_Bg3Light l = lsref_load_light(li);
    // cd: diffuse the shadow multiplies, ct: transmission it does not (thickness profiles).
    float3 cd, ct, cs, Ld;
    float d2, nol;
    if (!lsref_bg3_light_eval_mat(l, spot, sf, mt, cd, ct, cs, Ld, d2, nol)) continue;
    ++n_lights;
    bool shadowed = (l.flags & 1u) != 0u;
    float s = 1.0;
    if (shadowed && (validate || pc.ls_shadowed != 0 || qa)) s = lsref_bg3_atlas_shadow(l, spot, sf, Ld, d2, saturate(nol));
    n_shadowed += shadowed ? 1u : 0u;
    if (validate) {
      md += cd * s + ct;
      ms += cs * s;
      continue;
    }
    // Hair replaces its self-shadow by the atlas term for lights with a shadow map
    // (3033c895:483), which lsref_bg3_light_eval_mat does not model: those stay the game's.
    bool traced = shadowed ? (pc.ls_shadowed != 0 || qa) && cls != kMatHair : (qa || 1.0 / max(l.inv_r, 1e-12) >= pc.ls_min_radius);
    // Per-light data: the source radius, and whether this owner's lights are shadowed.
    float R = pc.ls_source_radius;
    if ((pc.ls_flags & 1u) != 0u) {
      uint4 si = lsSlots[uint2(min(li, 4095u), 0)];
      bool matched = (si.z & 0x10000u) != 0u;
      uint owner = si.z & 255u;
      if (matched) {
        ++n_matched;
        n_se += (si.y & 0x10000u) != 0u ? 1u : 0u;
        R = asfloat(si.x);
        if (!qa && ((pc.ls_flags >> (8u + min(owner, 4u))) & 1u) == 0u) {
          n_skipped += traced ? 1u : 0u;
          traced = false;
        }
      } else {
        ++n_unmatched;
      }
      dbg_owner += lsref_lum(cd + cs) * lsref_owner_colour(owner, matched);
    }
    if (!traced) continue;
    cd_all += cd;
    cs_all += cs;
    if (ns == 0) {
      const uint vs = qa ? kRtOccluded : lsref_trace_light(sf, l.pos, fp, li, cone, nol, R);
      float v = vs == kRtLit ? 1.0 : 0.0;
      n_traced += qa ? 0u : 1u;
      n_occ += vs == kRtOccluded && !qa ? 1u : 0u;
      float t = shadowed && pc.ls_shadowed == 2 ? min(v, s) : v;
      if (vs == kRtUnknown) v = t = s;   // (hand edit: unknown ray, the game's own term)
      if (qa) {                          // (hand edit: QA ambient floor)
        t = 0.0;
        dd -= ct;
      }
      dd += cd * (t - s);
      ds += cs * (t - s);
      td += cd * t;
      ts += cs * t;
      vd_all += cd * v;
    } else {
      float w = lsref_lum(cd + cs);
      if (!(w > 0.0)) continue;
      wsum += w;
      uint3 rr = lsref_ls_rand(fp, li ^ 0x200u);
      [unroll] for (uint k = 0; k < 2; ++k) {
        if (k >= ns) break;
        if (lsref_u01(k == 0 ? rr.x : rr.y) * wsum < w) {
          rd[k] = cd; rs[k] = cs; rp[k] = l.pos; rw[k] = w; rsh[k] = s; rk[k] = li; rside[k] = nol; rR[k] = R;
          rsel[k] = shadowed && pc.ls_shadowed == 2 ? 1.0 : 0.0;
        }
      }
    }
  }
  if (ns > 0 && wsum > 0.0) {
    [unroll] for (uint k = 0; k < 2; ++k) {
      if (k >= ns || !(rw[k] > 0.0)) continue;
      const uint vs = lsref_trace_light(sf, rp[k], fp, rk[k] ^ (0x300u + k), cone, rside[k], rR[k]);
      float v = vs == kRtLit ? 1.0 : 0.0;
      ++n_traced;
      n_occ += vs == kRtOccluded ? 1u : 0u;
      float t = rsel[k] > 0.5 ? min(v, rsh[k]) : v;
      if (vs == kRtUnknown) v = t = rsh[k];   // (hand edit: unknown ray, the game's own term)
      float inv_p = wsum / (rw[k] * float(ns));
      dd += rd[k] * ((t - rsh[k]) * inv_p);
      ds += rs[k] * ((t - rsh[k]) * inv_p);
      td += rd[k] * (t * inv_p);
      ts += rs[k] * (t * inv_p);
      vd_all += rd[k] * (v * inv_p);
    }
  }

  // ---- the game's factors on direct light: AO (b6 .x, as the lighting read it) ----
  float ao = lFlags.m0.x > 0.0 ? gAO[fp].x : 1.0;
  float spec_occ = lFlags.m0.x > 0.0 ? saturate(pow(max(abs(sf.nov_raw + ao), 9.9999997e-05), exp2(-16.0 * sf.a - 1.0)) - 1.0 + ao) : 1.0;
  float fdif = lerp(1.0, ao, lFlags.m0.y), fspec = lerp(1.0, spec_occ, lFlags.m0.y);

  // ---- the sun's direct light, as the lighting computed it (rt/bg3_sun.hlsli) ----
  const uint ao_mode = pc.ao_direct & 3u;
  const bool sun_in = (pc.ao_direct & 8u) != 0u;
  float3 sund = 0, suns = 0;
  if (sun_in && ((ao_mode != 0u && (pc.ao_direct & 4u) != 0u) || ao_mode == 2u || pc.ls_debug == 7)) {
    float m = pc.ls_has_mask != 0u && lFlags.m0.w > 0.0 ? gSunShadow[fp] : 1.0;
    float S = m * lsref_bg3_cloud_shadow(sf.P);
    if (S > 0.0)
      lsref_bg3_sun_eval_mat(sf, mt, normalize(cam.v0.xyz), lsref_bg3_sun_colour() * (S * asfloat(lScale.Load(0))), S, sund, suns);
    if (validate) {   // (ls_debug=7 only: the prep pass zeroes the mask otherwise)
      md += sund;
      ms += suns;
    }
  }
  // ---- AO on direct light (docs/archive/AUDIT_RT.md fix 4) ----
  // The lighting gives direct light mix(1, AO, m0.y) of the AO in b6, which holds
  // our 1-ray RT visibility once gi_ao_apply has run. ao_direct:
  //   0 leave it (the RT visibility darkens direct light, noisily, and contacts
  //     the RT shadows already resolve are darkened twice);
  //   1 none on the lights whose shadow is ray traced (D-LS lights, the sun with
  //     rt_shadows): their visibility IS the occlusion (default);
  //   2 the game's own factor with its own SSAO (the look of the original, noise-free).
  float3 xd = 0, xs = 0;
  if (ao_mode != 0u && !validate) {
    float ssao = (pc.ao_direct & 16u) != 0u ? gAux[fp].x : ao;
    float so = lFlags.m0.x > 0.0 ? saturate(pow(max(abs(sf.nov_raw + ssao), 9.9999997e-05), exp2(-16.0 * sf.a - 1.0)) - 1.0 + ssao) : 1.0;
    float td_f = ao_mode == 1u ? 1.0 : lerp(1.0, lFlags.m0.x > 0.0 ? ssao : 1.0, lFlags.m0.y);
    float ts_f = ao_mode == 1u ? 1.0 : lerp(1.0, so, lFlags.m0.y);
    float3 dir_d = td, dir_s = ts;
    if (ao_mode == 2u || (pc.ao_direct & 4u) != 0u) {
      dir_d += sund;
      dir_s += suns;
    }
    xd = dir_d * (td_f - fdif);
    xs = dir_s * (ts_f - fspec);
    xd = ls_giveback_cap(xd, gDiffuse[fp] + dd * (fdif * saturate(pc.ls_strength)), td_f, fdif);
    xs = ls_giveback_cap(xs, gSpecular[fp] + ds * (fspec * saturate(pc.ls_strength)), ts_f, fspec);
  }

  float3 gd = gDiffuse[fp], gs = gSpecular[fp];
  float3 od = gd, os = gs;
  if (validate) {
    md *= fdif;
    ms *= fspec;
    if (pc.ls_debug == 4 || pc.ls_debug == 6) {   // residual in grey; red where the recompute exceeds the game
      float over = lsref_lum(max(md - gd, 0.0) + max(ms - gs, 0.0));
      od = over > 1e-3 + 0.01 * lsref_lum(gd + gs) ? float3(1, 0, 0) : (gd + gs - md - ms);
      os = 0;
    } else {
      od = md;
      os = ms;
    }
  } else if (pc.ls_debug == 1) {   // light count: red unshadowed, green shadowed (1 = 8 lights)
    od = float3(float(n_lights - n_shadowed), float(n_shadowed), 0.0) / 8.0 * 0.5;
    os = 0;
  } else if (pc.ls_debug == 2) {   // light removed by the traced shadows, x4
    od = max(-(dd * fdif + ds * fspec), 0.0) * 4.0;
    os = 0;
  } else if (pc.ls_debug == 3) {   // traced visibility of the traced lights (luminance-weighted)
    float c = lsref_lum(cd_all);
    od = (c > 1e-6 ? saturate(lsref_lum(vd_all) / c) : 1.0).xxx * 0.5;
    os = 0;
  } else if (pc.ls_debug == 9) {   // the evaluated lights by owner (per-light data), luminance-weighted
    od = dbg_owner * 4.0;
    os = 0;
  } else if (pc.ls_debug == 8) {   // light given back by ao_direct (AO no longer on traced direct light), x4
    od = (xd + xs) * 4.0;
    os = 0;
  } else {
    float k = saturate(pc.ls_strength);
    od = max(gd + dd * (fdif * k) + xd, 0.0);
    os = max(gs + ds * (fspec * k) + xs, 0.0);
  }
  // Never hand the game a non-finite value.
  if (any(!isfinite(od))) od = gd;
  if (any(!isfinite(os))) os = gs;
  o_d = od;
  o_s = os;

  if (pc.ls_stats != 0) {
    uint bin = (fp.x >> 3) * 7 + (fp.y >> 3) * 13;
    lsref_stat_addv(16, 1u, bin);
    lsref_stat_addv(17, n_lights, bin);
    lsref_stat_addv(18, n_shadowed, bin);
    lsref_stat_addv(19, n_traced, bin);
    // Validation sums only where no projector light is listed (they are not recomputed).
    bool vpx = lsref_bg3_cluster_projectors(fp, d) == 0u;
    lsref_stat_addv(21, vpx ? lsref_fx(lsref_lum(gd + gs)) : 0u, bin);
    lsref_stat_addv(22, vpx ? lsref_fx(lsref_lum((md + ms))) : 0u, bin);
    lsref_stat_addv(15, vpx ? lsref_fx(lsref_lum(abs(gd - md) + abs(gs - ms))) : 0u, bin);
    // validation: the recompute above the game's own output (must be ~0), and where
    float over = lsref_lum(max(md - gd, 0.0) + max(ms - gs, 0.0));
    lsref_stat_addv(23, vpx ? lsref_fx(over) : 0u, bin);
    // the same, on the non-standard material classes alone
    bool nstd = cls != kMatStandard;
    lsref_stat_addv(69, nstd ? 1u : 0u, bin);
    bool nv = validate && nstd && vpx && n_lights > 0;
    lsref_stat_addv(64, nv ? 1u : 0u, bin);
    lsref_stat_addv(65, nv ? lsref_fx(lsref_lum(gd + gs)) : 0u, bin);
    lsref_stat_addv(66, nv ? lsref_fx(lsref_lum(md + ms)) : 0u, bin);
    lsref_stat_addv(67, nv ? lsref_fx(over) : 0u, bin);
    lsref_stat_addv(68, nv ? lsref_fx(lsref_lum(abs(gd - md) + abs(gs - ms))) : 0u, bin);
    // Regression game = k * recomputed + r over lit pixels, and r where no local light
    // reaches (validation: k must be 1 and r the same in both if the recompute is exact).
    if (validate) {
      float m = lsref_lum(md + ms), g = lsref_lum(gd + gs);
      // standard-class pixels only (the other classes have their own counters, 48-52)
      bool lit = vpx && n_lights > 0 && cls == kMatStandard, unlit = vpx && n_lights == 0 && cls == kMatStandard;
      lsref_stat_addv(32, lit ? 1u : 0u, bin);
      lsref_stat_addv(33, lit ? uint(min(m, 0.5) * 1e5) : 0u, bin);
      lsref_stat_addv(34, lit ? uint(min(g, 0.5) * 1e5) : 0u, bin);
      lsref_stat_addv(35, lit ? uint(min(m * m, 0.02) * 1e7) : 0u, bin);
      lsref_stat_addv(36, lit ? uint(min(m * g, 0.02) * 1e7) : 0u, bin);
      lsref_stat_addv(37, unlit ? 1u : 0u, bin);
      lsref_stat_addv(38, unlit ? uint(min(g, 0.5) * 1e5) : 0u, bin);
    }
    lsref_stat_addv(20, validate && over > 1e-3 + 0.01 * lsref_lum(gd + gs) ? 1u : n_occ, bin);
    lsref_stat_addv(24, lsref_fx(-lsref_lum(dd * fdif + ds * fspec)), bin);
    lsref_stat_addv(74, lsref_fx(lsref_lum(xd + xs)), bin);   // light given back by ao_direct
    lsref_stat_addv(75, lsref_fx(lsref_lum(sund * fdif + suns * fspec)), bin);
    // per-light data: evaluations matched (any source / the bridge), owner not traced, unmatched
    lsref_stat_addv(76, n_matched, bin);
    lsref_stat_addv(77, n_se, bin);
    lsref_stat_addv(78, n_skipped, bin);
    lsref_stat_addv(79, n_unmatched, bin);   // the sun as recomputed (with the game's AO factor)
    lsref_stat_addv(25, n_lights > 0 ? 1u : 0u, bin);
    lsref_stat_addv(26, cl.y + cl.z, bin);   // lights listed in the froxel
    lsref_stat_addv(31, lsref_bg3_cluster_projectors(fp, d), bin);   // projector lights listed (not handled)
    if (all(fp == uint2(0, 0))) {
      // raw values, read from the latest slot (not summed)
      rtStats.Store((27 * 64) * 4, asuint(lFlags.m0.x));
      rtStats.Store((28 * 64) * 4, asuint(lFlags.m0.y));
      rtStats.Store((29 * 64) * 4, asuint(lFlags.m0.w));
      rtStats.Store((30 * 64) * 4, lScale.Load(0));
      rtStats.Store((70 * 64) * 4, asuint((pc.mat_classes & 8u) != 0u ? gFrame.b.x : -1.0));   // set0/b0 _m4
    }
  }
  return true;
}

